{
  "name": "athleteos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rls": "node test_rls_regression.mjs",
    "test:integration": "node test_rls_regression.mjs && node test_signup_regression.mjs && node test_send_push_regression.mjs && node test_admin_actions.mjs && node test_import_club_athletes.mjs && node test_charge_model_parity.mjs && node test_axis_model_parity.mjs && node test_competition_transactions.mjs && node test_private_storage.mjs && node test_performance_normalization.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.14",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.6",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "read-excel-file": "^7.0.3",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.17"
  }
}
