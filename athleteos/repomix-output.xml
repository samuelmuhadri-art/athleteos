      <div className="flex-1 min-w-0">
        <div className="flex items-end gap-2">
          <p
            className="text-[26px] font-bold leading-none tracking-tight"
            style={{ color, fontVariantNumeric: "tabular-nums", letterSpacing: "-0.03em" }}
