FOR ALL TO authenticated
USING (
  EXISTS (
    SELECT 1
    FROM public.athletes athlete
    WHERE athlete.id = athlete_daily_load_days.athlete_id
      AND athlete.club_id = public.get_my_club_id()
      AND (
