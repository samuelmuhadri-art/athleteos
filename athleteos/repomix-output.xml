              style={{ accentColor: intColor, background: "var(--c-surface-3)" }} />
            <div className="flex justify-between text-[12px] mt-1" style={{ color: "var(--c-text-3)" }}>
              <span>Légère</span><span>Modérée</span><span>Intense</span>
