                  <h3 className="card-title">Analyse du groupe — {selectedDisc}</h3>
                  <span className="text-[12px] bg-[rgba(255,255,255,0.08)] text-[var(--c-text-2)] px-2 py-1 rounded-full font-medium ml-1">Analyse automatique</span>
