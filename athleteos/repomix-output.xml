// (tâche 19) depuis test_discipline_registry.mjs — fonctions pures,
// aucune base de données requise.
// ============================================================

import { describe, it, expect } from "vitest";
import {
  DISCIPLINES, validateRegistry, resolveDisciplineId, getDiscipline,
