      )}

      <div>
        <p style={{ fontSize: 10, fontWeight: 600, color: "var(--c-text-3)", textTransform: "uppercase", letterSpacing: "0.06em", marginBottom: 8 }}>
          Séances ({sessions.length})
        </p>
        {sessions.length === 0 ? (
