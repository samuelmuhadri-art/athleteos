                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {scatterData.length >= 2 && (
                <div className="card p-5">
                  <div className="mb-4">
                    <h3 className="card-title">Charge vs Performance — {selectedDisc}</h3>
