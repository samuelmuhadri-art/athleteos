      END IF;
      n := (axis_val#>>'{}')::numeric;
      IF n < 0 OR n > 1 THEN
        RAISE EXCEPTION 'axis_weights.%.% doit être entre 0 et 1 (reçu: %)', cat, axis, n;
      END IF;
