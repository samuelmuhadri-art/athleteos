                          {daysLeft > 0 ? `J-${daysLeft}` : "Échu"}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Feedbacks récents */}
          {recentFeedbacks.length > 0 && (
            <div className="card overflow-hidden">
              <div className="px-5 py-4 border-b border-[color:var(--c-border)]">
