  const intColor = form.intensity <= 3 ? "#1D9E75" : form.intensity <= 6 ? "#EF9F27" : "#E24B4A";

  const handleSubmit = async () => {
    if (!form.name.trim()) return;
    setSaving(true); setErr(null);
