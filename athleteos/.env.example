# Copiez ce fichier en .env et renseignez les valeurs réelles (Supabase Dashboard > Project Settings > API).
# Toutes les variables VITE_* sont exposées au bundle client par Vite : n'y mettez jamais de secret serveur.

# URL du projet Supabase
VITE_SUPABASE_URL=

# Clé publique "anon" Supabase — protégée par les policies RLS, à ne pas confondre avec service_role
VITE_SUPABASE_ANON_KEY=

# Clé publique VAPID pour les notifications push web
VITE_VAPID_PUBLIC_KEY=

# DSN Sentry pour le suivi d'erreurs frontend (optionnel, laisser vide pour désactiver)
VITE_SENTRY_DSN=

# --- Variables serveur uniquement — NE JAMAIS mettre dans ce fichier ni dans le frontend ---
# SUPABASE_SERVICE_ROLE_KEY : requise par supabase/functions/*/index.ts (Edge Functions)
#   et par test_rls_regression.mjs en local/CI. À définir comme secret CI/Supabase, jamais en .env.
