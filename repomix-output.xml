        width: "100%",
        maxWidth: 560,
        maxHeight: "92dvh",
        display: "flex",
        flexDirection: "column",
        overflow: "hidden",
        boxShadow: "0 -8px 40px rgba(0,0,0,0.50)",
        animation: "sheet-up 0.32s cubic-bezier(0.16,1,0.3,1) both",
      }}>

        {/* Poignée */}
        <div style={{ display: "flex", justifyContent: "center", paddingTop: 10, paddingBottom: 4, flexShrink: 0 }}>
